{
  "name": "biff-scheduler",
  "version": "0.1.0",
  "private": true,
  "description": "BIFF 电影节排片工具，React Router + React Spectrum S2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && npm run lint && npm run test && vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@react-aria/optimize-locales-plugin": "^2.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lightningcss": "^1.33.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "unplugin-parcel-macros": "^0.2.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@react-spectrum/s2": "^1.7.1",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1"
  }
}
