{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "biff-scheduler",
  "account_id": "62cbe67b545f2d12c986729ac7ffcee8",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ENV": "production",
    // biff.iff.day 是迁移目标,已登记进白名单与账号系统的回调,但自定义域名尚未挂到本 Worker,
    // 该子域当前无 DNS 解析 —— 生效域名只有 biff.lcandy.co。挂载后本行无需改动,详见 docs/account-integration.md。
    "APP_ORIGIN": "https://biff.lcandy.co,https://biff.iff.day",
    "IFFDAY_ORIGIN": "https://account.iff.day",
    "OIDC_CLIENT_ID": "biff-scheduler",
  },
  "services": [{ "binding": "WEB", "service": "biff-scheduler-web" }, { "binding": "IFFDAY_API", "service": "iffday-account-api" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "biff-account-data",
      "database_id": "67301f90-424f-4fc4-b0ca-0a95ac0ca494",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
}
