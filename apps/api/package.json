{
  "name": "@biff/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c wrangler.jsonc",
    "typecheck": "wrangler types && tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist -c wrangler.jsonc",
    "deploy": "wrangler deploy -c wrangler.jsonc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply biff-account-data --local -c wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply biff-account-data --remote -c wrangler.jsonc"
  },
  "dependencies": {
    "hono": "4.13.7",
    "oauth4webapi": "3.8.8",
    "zod": "4.6.2",
    "drizzle-orm": "0.45.2",
    "@biff/contracts": "*"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "typescript": "^5.6.0",
    "wrangler": "4.131.1"
  }
}
